{
	"lsp": {
		"eslint": {
			"settings": {
				"options": {
					"overrideConfigFile": "./linters/eslint.config.js"
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--config", "./linters/prettier.config.js", "--ignore-path", "./linters/.prettierignore", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"format_on_save": "on"
		},
		"TypeScript": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--config", "./linters/prettier.config.js", "--ignore-path", "./linters/.prettierignore", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"format_on_save": "on"
		}
	}
}
